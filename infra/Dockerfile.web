FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm install

COPY . .

RUN npm run --workspace @wiki/shared build
RUN npm run --workspace @wiki/web build

EXPOSE 4173

CMD ["npm", "run", "--workspace", "@wiki/web", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
